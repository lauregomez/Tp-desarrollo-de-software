generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@map("roles")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  lastName     String   @map("last_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @relation(fields: [roleId], references: [id])
  roleId       Int      @map("role_id")
  tickets      Ticket[]
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Club {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  courts      Court[]
  homeMatches Match[] @relation("HomeClub")
  awayMatches Match[] @relation("AwayClub")

  @@map("clubs")
}

model Court {
  id       Int     @id @default(autoincrement())
  name     String
  capacity Int
  club     Club    @relation(fields: [clubId], references: [id])
  clubId   Int     @map("club_id")
  matches  Match[]

  @@unique([clubId, name])
  @@map("courts")
}

model Match {
  id         Int         @id @default(autoincrement())
  startsAt   DateTime    @map("starts_at")
  price      Decimal     @db.Decimal(10, 2)
  category   Category
  capacity   Int?
  homeClub   Club        @relation("HomeClub", fields: [homeClubId], references: [id])
  homeClubId Int         @map("home_club_id")
  awayClub   Club        @relation("AwayClub", fields: [awayClubId], references: [id])
  awayClubId Int         @map("away_club_id")
  court      Court       @relation(fields: [courtId], references: [id])
  courtId    Int         @map("court_id")
  tickets    Ticket[]
  status     MatchStatus @default(DRAFT)
  createdAt  DateTime    @default(now()) @map("created_at")

  @@map("matches")
}

enum Category {
  PRIMERA
  RESERVA
  CUARTA
  QUINTA
}

enum MatchStatus {
  DRAFT
  PUBLISHED
  FINISHED
  CANCELLED
}

model Ticket {
  id            Int          @id @default(autoincrement())
  code          String?      @unique
  status        TicketStatus @default(PENDING)
  pricePaid     Decimal      @map("price_paid") @db.Decimal(10, 2)
  reservedUntil DateTime?    @map("reserved_until")
  mpPaymentId   String?      @map("mp_payment_id")
  user          User         @relation(fields: [userId], references: [id])
  userId        Int          @map("user_id")
  match         Match        @relation(fields: [matchId], references: [id])
  matchId       Int          @map("match_id")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([matchId, status])
  @@map("tickets")
}

enum TicketStatus {
  PENDING
  ACTIVE
  USED
}
