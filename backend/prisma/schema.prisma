generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@map("roles")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  lastName     String   @map("last_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @relation(fields: [roleId], references: [id])
  roleId       Int      @map("role_id")
  tickets      Ticket[]
  matchLogs    MatchLog[]
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Club {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  logoUrl     String? @map("logo_url") @db.VarChar(500)
  description String? @db.Text
  foundedYear Int?    @map("founded_year")
  courts      Court[]
  homeMatches Match[] @relation("HomeClub")
  awayMatches Match[] @relation("AwayClub")

  @@map("clubs")
}

model Court {
  id       Int     @id @default(autoincrement())
  name     String
  address  String
  capacity Int
  club     Club    @relation(fields: [clubId], references: [id])
  clubId   Int     @map("club_id")
  matches  Match[]

  @@unique([clubId, name])
  @@map("courts")
}

model Match {
  id         Int         @id @default(autoincrement())
  startsAt   DateTime    @map("starts_at")
  price      Decimal     @db.Decimal(10, 2)
  category   Category
  capacity   Int?
  homeClub   Club?       @relation("HomeClub", fields: [homeClubId], references: [id], onDelete: SetNull)
  homeClubId Int?        @map("home_club_id")
  awayClub   Club?       @relation("AwayClub", fields: [awayClubId], references: [id], onDelete: SetNull)
  awayClubId Int?        @map("away_club_id")
  court      Court?      @relation(fields: [courtId], references: [id], onDelete: SetNull)
  courtId    Int?        @map("court_id")
  tickets    Ticket[]
  logs       MatchLog[]
  status     MatchStatus @default(DRAFT)
  createdAt  DateTime    @default(now()) @map("created_at")

  @@map("matches")
}

enum Category {
  PRIMERA
  RESERVA
  CUARTA
  QUINTA
}

enum MatchStatus {
  DRAFT
  PUBLISHED
  FINISHED
  CANCELLED
}

model Ticket {
  id            Int          @id @default(autoincrement())
  code          String?
  status        TicketStatus @default(PENDING)
  pricePaid     Decimal      @map("price_paid") @db.Decimal(10, 2)
  mpOrderId     String?      @map("mp_order_id")
  mpPaymentId   String?      @map("mp_payment_id")
  user          User         @relation(fields: [userId], references: [id])
  userId        Int          @map("user_id")
  match         Match        @relation(fields: [matchId], references: [id])
  matchId       Int          @map("match_id")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@unique([matchId, code])
  @@index([matchId, status])
  @@index([mpOrderId])
  @@map("tickets")
}



enum TicketStatus {
  PENDING
  ACTIVE
  USED
}

model MatchLog {
  id          Int      @id @default(autoincrement())
  description String   @db.VarChar(500)
  match       Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  matchId     Int?     @map("match_id")
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("match_logs")
}