generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  usuarios Usuario[]
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nombre   String
  email    String   @unique
  password String
  rol      Rol      @relation(fields: [rolId], references: [id])
  rolId    Int
  entradas Entrada[]
  creadoEn DateTime @default(now())
}

model Club {
  id                Int       @id @default(autoincrement())
  nombre            String    @unique
  canchas           Cancha[]
  partidosLocal     Partido[] @relation("Local")
  partidosVisitante Partido[] @relation("Visitante")
}

model Cancha {
  id       Int       @id @default(autoincrement())
  nombre   String
  capacidad Int
  club     Club      @relation(fields: [clubId], references: [id])
  clubId   Int
  partidos Partido[]
}

model Partido {
  id              Int           @id @default(autoincrement())
  fecha           DateTime
  precio          Decimal       @db.Decimal(10, 2)
  clubLocal       Club          @relation("Local", fields: [clubLocalId], references: [id])
  clubLocalId     Int
  clubVisitante   Club          @relation("Visitante", fields: [clubVisitanteId], references: [id])
  clubVisitanteId Int
  cancha          Cancha        @relation(fields: [canchaId], references: [id])
  canchaId        Int
  entradas        Entrada[]
  estado          EstadoPartido @default(BORRADOR)
  creadoEn        DateTime      @default(now())
}

enum EstadoPartido {
  BORRADOR
  PUBLICADO
  FINALIZADO
  CANCELADO
}

model Entrada {
  id              Int           @id @default(autoincrement())
  codigo          String?       @unique
  estado          EstadoEntrada @default(PENDIENTE)
  precioPagado    Decimal       @db.Decimal(10, 2)
  reservaExpiraEn DateTime?
  mpPaymentId     String?
  usuario         Usuario       @relation(fields: [usuarioId], references: [id])
  usuarioId       Int
  partido         Partido       @relation(fields: [partidoId], references: [id])
  partidoId       Int
  creadoEn        DateTime      @default(now())

  @@index([partidoId, estado])
}

enum EstadoEntrada {
  PENDIENTE
  ACTIVA
  USADA
}